# TutorLive Environment Variables
# Rename this file to .env.local and fill in your values

# ─── Database (Supabase) ──────────────────────────────────────────────
# Get from: Supabase dashboard → Settings → Database → Connection string (Transaction mode)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ─── Supabase (Storage + Realtime) ───────────────────────────────────
# Get from: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Clerk Auth ────────────────────────────────────────────────────────
# Get from: clerk.com → Your App → API Keys (reuse demo keys!)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────
# Generate App Password: myaccount.google.com/apppasswords
GMAIL_USER="youremail@gmail.com"
GMAIL_APP_PASSWORD="rhox mirg ydqb frgi"

# ─── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
